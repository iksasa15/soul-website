# Public site URL used for canonical links, sitemap and social previews.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://example.com

# Free access key from https://web3forms.com (create it with soulcompany.om@gmail.com).
# Without it, the contact form opens the visitor's email app instead.
NEXT_PUBLIC_WEB3FORMS_KEY=
